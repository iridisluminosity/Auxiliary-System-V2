-- Função principal de apply das flags ;D
local function applyFlags()
    local changed = 0
    local noChangeCount = 0  -- Contador pra auto-adjust wait
    
    for _, flag in ipairs(FLAGS) do
        pcall(function()
            local current
            if flag.type == "number" then
                current = game:GetFastInt(flag.name)
            elseif flag.type == "boolean" then
                current = game:GetFastFlag(flag.name)
            elseif flag.type == "string" then
                current = game:GetFastString(flag.name)
            end
            
            if current ~= flag.value then
                setfflag(flag.name, tostring(flag.value))
                print("📈✅ Setado " .. flag.name .. " → " .. tostring(flag.value))
                changed = changed + 1
                noChangeCount = 0  -- Reseta se mudou alguma flag
            end
        end)
    end
    
    if changed > 0 then
        print("🚀 " .. changed .. " FFlags ajustadas! 📊💪")
    else
        noChangeCount = noChangeCount + 1
        if noChangeCount >= 5 then
            print("🔍😴 Sem mudanças por 5 ciclos - aumentando wait pra 2s pra menos overhead.")
            return 2  -- Retorna wait maior pra não ter overhead
        end
    end
    
    return 0.5  -- Wait padrão
end

-- Loop principal pras flags :P
while not _G.StopFFLoop do
    local waitTime = applyFlags()
    wait(waitTime)
end

print("🛑 Loop de flags parado")
