--// ◈ AUXILIARY OPTIMIZATION ◈

local success, err = pcall(function()

    --// Services
    local Lighting = game:GetService("Lighting")

    --// Initialization
    print("◈ AUXILIARY SYSTEM ◈")
    print("Initializing Optimization Suite...")

    --// Rendering Optimization
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)

    --// Optimization Function
    local function Optimize(Object)

        if Object:IsA("BasePart") then

            Object.Material = Enum.Material.Plastic
            Object.Reflectance = 0
            Object.CastShadow = false

        elseif Object:IsA("Decal")
            or Object:IsA("Texture") then

            Object.Transparency = 1

        elseif Object:IsA("ParticleEmitter")
            or Object:IsA("Trail")
            or Object:IsA("Smoke")
            or Object:IsA("Fire")
            or Object:IsA("Sparkles") then

            Object.Enabled = false

        elseif Object:IsA("PostEffect") then

            Object.Enabled = false

        end
    end

    --// Optimize Existing Objects
    for _, Object in ipairs(game:GetDescendants()) do

        pcall(function()
            Optimize(Object)
        end)
    end

    --// Optimize Future Objects
    game.DescendantAdded:Connect(function(Object)

        pcall(function()
            Optimize(Object)
        end)
    end)

    --// Lighting Optimization
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 9e9
    Lighting.Brightness = 1

    for _, Effect in ipairs(Lighting:GetChildren()) do

        if Effect:IsA("PostEffect") then
            Effect.Enabled = false
        end
    end

    --// Terrain Optimization
    local Terrain = workspace:FindFirstChildOfClass("Terrain")

    if Terrain then

        Terrain.WaterWaveSize = 0
        Terrain.WaterWaveSpeed = 0
        Terrain.WaterReflectance = 0
        Terrain.WaterTransparency = 0
    end

    --// Final Output
    print("◈ AUXILIARY OPTIMIZATION ◈")
    print("Rendering Pipeline Stabilized")
    print("Visual Effects Reduced")
    print("Performance Optimization Applied")
    print("Status: SUCCESS")

end)

if not success then

    warn("◈ AUXILIARY SYSTEM ERROR ◈")
    warn(err)

end
