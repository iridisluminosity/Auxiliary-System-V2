--// MÉTODO 3: TELEPORTE POR VELOCIDADE INSTANTÂNEA
--////////////////////////////////////////////////////////////

-- Salvar posição original
local OriginalPosition = HumanoidRootPart.Position

-- Desabilitar física temporariamente
Humanoid.AutoRotate = false
Humanoid.PlatformStand = true

-- Aplicar velocidade extrema por 1 frame
local BodyVelocity = Instance.new("BodyVelocity")
BodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
BodyVelocity.Velocity = (TargetRoot.Position - HumanoidRootPart.Position).Unit * 100000
BodyVelocity.Parent = HumanoidRootPart

-- Esperar 1 frame
task.wait()

-- Parar e ajustar posição
BodyVelocity:Destroy()

-- Teleporte final suave
local TweenService = game:GetService("TweenService")
local Tween = TweenService:Create(HumanoidRootPart, TweenInfo.new(0.05), {
    CFrame = TargetRoot.CFrame * CFrame.new(0, 0, -3)
})
Tween:Play()
Tween.Completed:Wait()

-- Reativar física
Humanoid.AutoRotate = true
Humanoid.PlatformStand = false

-- Face target
task.wait(0.1)
HumanoidRootPart.CFrame = CFrame.lookAt(HumanoidRootPart.Position, TargetRoot.Position)

Notify("TELEPORT COMPLETE → " .. Target.Name)
