--////////////////////////////////////////////////////////////
--// INTEGRITY LINK  
--// TARGET TELEPORT (MÉTODOS ALTERNATIVOS)
--////////////////////////////////////////////////////////////

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

local Humanoid = Character:WaitForChild("Humanoid")
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")

local Target = getgenv().IntegrityTarget

if not Target then
    return
end

local TargetCharacter = Target.Character or Target.CharacterAdded:Wait()
local TargetRoot = TargetCharacter:FindFirstChild("HumanoidRootPart")

if not TargetRoot then
    return
end

--////////////////////////////////////////////////////////////
--// EFFECTS
--////////////////////////////////////////////////////////////

local function Notify(Text)
    pcall(function()
        game.StarterGui:SetCore(
            "SendNotification",
            {
                Title = "INTEGRITY LINK",
                Text = Text,
                Duration = 3
            }
        )
    end)
end

Notify("LINK ESTABLISHED → " .. Target.Name)

--////////////////////////////////////////////////////////////
--// MÉTODO 1: TWEEN SERVICE (TRANSIÇÃO SUAVE)
--////////////////////////////////////////////////////////////

local TweenService = game:GetService("TweenService")

local TweenInfo = TweenInfo.new(
    0.2,  -- Duração
    Enum.EasingStyle.Linear,
    Enum.EasingDirection.Out
)

local NewCFrame = TargetRoot.CFrame * CFrame.new(0, 0, -3)
local Tween = TweenService:Create(HumanoidRootPart, TweenInfo, {CFrame = NewCFrame})
Tween:Play()

Tween.Completed:Wait()

--////////////////////////////////////////////////////////////
--// AUTO FACE TARGET
--////////////////////////////////////////////////////////////

task.wait(0.1)

local FaceTween = TweenService:Create(HumanoidRootPart, TweenInfo, {
    CFrame = CFrame.lookAt(HumanoidRootPart.Position, TargetRoot.Position)
})
FaceTween:Play()

Notify("TELEPORT COMPLETE → " .. Target.Name)
