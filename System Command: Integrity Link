--////////////////////////////////////////////////////////////
--// INTEGRITY LINK
--// TARGET TELEPORT - WELD METHOD (HEAD)
--////////////////////////////////////////////////////////////

local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

local Humanoid = Character:WaitForChild("Humanoid")
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")

local Target = getgenv().IntegrityTarget

if not Target then
    return
end

local TargetCharacter = Target.Character or Target.CharacterAdded:Wait()
local TargetHead = TargetCharacter:FindFirstChild("Head")

if not TargetHead then
    return
end

--////////////////////////////////////////////////////////////
--// EFFECTS
--////////////////////////////////////////////////////////////

local function Notify(Text)
    pcall(function()
        game.StarterGui:SetCore(
            "SendNotification",
            {
                Title = "INTEGRITY LINK",
                Text = Text,
                Duration = 3
            }
        )
    end)
end

Notify("LINK ESTABLISHED → " .. Target.Name)

--////////////////////////////////////////////////////////////
--// TELEPORTE PELO MÉTODO WELD (DIRETO NA CABEÇA)
--////////////////////////////////////////////////////////////

-- Desabilitar colisão temporariamente
HumanoidRootPart.CanCollide = false
Humanoid.PlatformStand = true

-- Criar o Weld para teleportar direto na cabeça
local Weld = Instance.new("Weld")
Weld.Part0 = HumanoidRootPart
Weld.Part1 = TargetHead
Weld.C0 = CFrame.new(0, 0, 0)
Weld.Parent = HumanoidRootPart

-- Dar tempo para o weld ativar
task.wait(0.05)

-- Destruir o weld
Weld:Destroy()

-- Ajustar rotação para olhar para o alvo
task.wait(0.1)
HumanoidRootPart.CFrame = CFrame.lookAt(
    HumanoidRootPart.Position,
    TargetHead.Position
)

-- Reativar colisão
HumanoidRootPart.CanCollide = true
Humanoid.PlatformStand = false

Notify("TELEPORTED TO → " .. Target.Name .. "'s HEAD")
