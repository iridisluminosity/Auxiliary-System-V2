-- Desabilitar colisões temporariamente
HumanoidRootPart.CanCollide = false

-- Criar AlignPosition para teleporte suave
local AlignPosition = Instance.new("AlignPosition")
local Attachment1 = Instance.new("Attachment")
local Attachment2 = Instance.new("Attachment")

Attachment1.Parent = HumanoidRootPart
Attachment2.Parent = TargetRoot

AlignPosition.Attachment1 = Attachment1
AlignPosition.Attachment2 = Attachment2
AlignPosition.MaxForce = 1000000
AlignPosition.MaxVelocity = math.huge
AlignPosition.Responsiveness = 200
AlignPosition.ReactionForceEnabled = false
AlignPosition.Parent = HumanoidRootPart

-- Criar AlignOrientation para rotação
local AlignOrientation = Instance.new("AlignOrientation")
AlignOrientation.Attachment1 = Attachment1
AlignOrientation.Attachment2 = Attachment2
AlignOrientation.MaxTorque = 1000000
AlignOrientation.Responsiveness = 200
AlignOrientation.Parent = HumanoidRootPart

task.wait(0.1)

-- Limpar
AlignPosition:Destroy()
AlignOrientation:Destroy()
Attachment1:Destroy()
Attachment2:Destroy()
HumanoidRootPart.CanCollide = true

-- Forçar posição final
HumanoidRootPart.CFrame = TargetRoot.CFrame * CFrame.new(0, 0, -3)

-- Face target
task.wait(0.1)
HumanoidRootPart.CFrame = CFrame.lookAt(HumanoidRootPart.Position, TargetRoot.Position)

Notify("TELEPORT COMPLETE → " .. Target.Name)
